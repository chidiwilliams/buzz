#: buzz/plugins/enhanced_language_detection/plugin.py
msgid "Enhanced language detection"
msgstr "Gelişmiş dil algılama"

#: buzz/plugins/enhanced_language_detection/plugin.py
msgid ""
"Detect the spoken language with whisper.cpp before transcription (using the "
"largest downloaded model, or the tiny model otherwise) and use it for the "
"transcription and exported file names. Only runs when the language is set to"
" auto-detect."
msgstr ""
"Deşifreden önce konuşulan dili whisper.cpp ile algılar (indirilmiş en büyük "
"modeli, yoksa tiny modelini kullanarak) ve bu dili deşifre ile dışa "
"aktarılan dosya adlarında kullanır. Yalnızca dil otomatik algılamaya "
"ayarlıysa çalışır."

#: buzz/plugins/enhanced_language_detection/plugin.py
msgid "Download tiny model if none available"
msgstr "Hiç model yoksa tiny modelini indir"

#: buzz/plugins/enhanced_language_detection/plugin.py
msgid ""
"If no whisper.cpp model is downloaded, download the tiny model to use for "
"language detection."
msgstr ""
"Hiç whisper.cpp modeli indirilmemişse, dil algılamada kullanmak için tiny "
"modelini indirir."

#: buzz/plugins/ai_summary/plugin.py
msgid "AI Summary"
msgstr "Yapay Zekâ Özeti"

#: buzz/plugins/ai_summary/plugin.py
msgid ""
"Generate an AI summary of the transcript via an OpenAI-compatible API and "
"save it to the Notes field and/or a file."
msgstr ""
"OpenAI uyumlu bir API aracılığıyla deşifrenin yapay zekâ özetini oluşturur "
"ve Notlar alanına ve/veya bir dosyaya kaydeder."

#: buzz/plugins/ai_summary/plugin.py
msgid "API base URL"
msgstr "API temel URL'si"

#: buzz/plugins/ai_summary/plugin.py
msgid "API key"
msgstr "API anahtarı"

